{
  "manifest_version": 3,
  "name": "Aquaman",
  "short_name": "Aquaman",
  "version": "1.7.2",
  "description": "Compagnon pour le jeu de cartes de poseidon-scans.net : classement entre amis, boosters rentables, cartes possédées dans les échanges, vitrine en glisser-déposer.",
  "author": "A-Finch13",
  "homepage_url": "https://github.com/A-Finch13/Poseidon-TCG",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Aquaman",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "host_permissions": ["https://poseidon-scans.net/*", "https://aquaman-relay.finch-arhold-git.workers.dev/*"],
  "content_scripts": [
    {
      "matches": ["https://poseidon-scans.net/*"],
      "js": ["src/content/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://poseidon-scans.net/*"],
      "js": [
        "src/content/tour/steps.js",
        "src/content/tour/changes.js",
        "src/content/core/base.js",
        "src/content/core/messages.js",
        "src/content/core/game-write.js",
        "src/content/core/transfer.js",
        "src/content/core/state.js",
        "src/content/core/dom.js",
        "src/content/queues/wants.js",
        "src/content/queues/sales.js",
        "src/content/market/bought.js",
        "src/content/market/sales-card.js",
        "src/content/market/my-bids.js",
        "src/content/market/unlist.js",
        "src/content/menu/plus-tab.js",
        "src/content/menu/overlay.js",
        "src/content/menu/boosters.js",
        "src/content/menu/who-has.js",
        "src/content/menu/players.js",
        "src/content/menu/sales-recap.js",
        "src/content/card/card-who.js",
        "src/content/card/listings.js",
        "src/content/collection/missing-sales.js",
        "src/content/collection/album.js",
        "src/content/collection/strip-wheel.js",
        "src/content/collection/strip-drag.js",
        "src/content/collection/showcase.js",
        "src/content/trades/marks.js",
        "src/content/trades/filters.js",
        "src/content/home/big-pulls.js",
        "src/content/home/booster-piles.js",
        "src/content/home/booster-scan.js",
        "src/content/home/open-more.js",
        "src/content/home/booster-wheel.js",
        "src/content/recycle/recycle-dialog.js",
        "src/content/recycle/recycle-spares.js",
        "src/content/tour/tour.js",
        "src/content/tour/news.js",
        "src/content/app/events.js",
        "src/content/app/updates.js",
        "src/content/app/main.js"
      ],
      "css": [
        "src/content/styles/01-base.css",
        "src/content/styles/02-plus-menu.css",
        "src/content/styles/03-window.css",
        "src/content/styles/05-boosters.css",
        "src/content/styles/06-card-trades-pulls.css",
        "src/content/styles/07-showcase.css",
        "src/content/styles/08-update.css",
        "src/content/styles/09-tour.css",
        "src/content/styles/10-phone.css",
        "src/content/styles/11-news.css",
        "src/content/styles/12-boosters-filters.css",
        "src/content/styles/13-strips.css",
        "src/content/styles/15-booster-choice.css",
        "src/content/styles/16-settings.css",
        "src/content/styles/17-who-pulled.css",
        "src/content/styles/19-album.css",
        "src/content/styles/20-who-has.css",
        "src/content/styles/21-search-queue.css",
        "src/content/styles/22-sell.css",
        "src/content/styles/23-booster-wheel.css",
        "src/content/styles/24-card-listings.css",
        "src/content/styles/25-collection.css",
        "src/content/styles/26-players.css",
        "src/content/styles/27-market.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "aquaman@a-finch13",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
